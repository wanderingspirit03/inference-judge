# /etc/inference-judge/loop.env -- read by inference-judge-driver, inference-judge-runner and inference-judge-heartbeat.
# setup/harden_research.sh installs this file (0640 root:driver) if absent.
# Quote values with spaces: systemd strips the quotes and so does `. loop.env`.
HOME=/home/driver
PATH=/usr/local/bin:/usr/bin:/bin
IJ_STATE_DIR=/home/driver/research-state
IJ_RESEARCH_DIR=/home/researcher/research
# The units run the root-owned install in /opt/inference-judge/loop (harden_research.sh
# copies research/loop there), so the researcher cannot swap the driver by
# renaming research/loop.  Both copies, the guard, the adapters and the agent's
# own folder (.claude for claude, .codex for codex) are hashed every pass.
# setup/harden_research.sh keeps this line and IJ_AGENT in step with what it installs.
IJ_FROZEN_PATHS=/opt/inference-judge:/home/researcher/research/loop:/home/researcher/research/guard:/home/researcher/research/adapters:/home/researcher/research/.claude
IJ_LEGACY_STATE=/home/researcher/research/loop/state.json
IJ_PREFLIGHT_CMD=/opt/inference-judge/loop/preflight.sh
IJ_RESULTS_DIR=/opt/bench/results
IJ_BENCH_CMD="sudo -n -u bench /opt/bench/run.sh"
# Sessions, pre-flight, git commits and job reaping run as the researcher.
IJ_RESEARCHER_SUDO="sudo -n -u researcher -H"
IJ_RESEARCHER_USER=researcher
# The coding agent that does the research: a folder in /opt/inference-judge/adapters
# (claude, codex, pi or your own).
IJ_AGENT=claude
# sudo replaces PATH with secure_path, so the agent's command must be in
# /usr/local/bin or /usr/bin (bootstrap's `npm install -g` is); a ~/.local/bin
# install needs this:
#IJ_AGENT_BIN=/usr/local/bin/claude
IJ_JOBS_SPOOL=/home/researcher/.inference-judge-jobs
IJ_PY=/usr/bin/python3
# Alerts: an http(s) URL gets an ntfy-style POST (e.g. https://ntfy.sh/<secret-topic>),
# anything else is a file to append to.
IJ_ALERT=/home/driver/research-state/ALERTS.push
# Policy (defaults shown).
# The two words mean whatever the adapter's session.sh maps them to (Claude:
# opus and sonnet; Codex and Pi: the model the tool is configured to use).  Any
# other value is passed to the agent as a model name.
#IJ_PRIMARY_MODEL=primary
#IJ_FALLBACK_MODEL=fallback
#IJ_MAX_CRASHES=3
#IJ_FALLBACK_SESSIONS=3
#IJ_ITER_TIMEOUT_S=3600
#IJ_QUEUE_TARGET=2
#IJ_TIMER_S=3600
