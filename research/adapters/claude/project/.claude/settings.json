{
  "$comment": "inference-judge trust boundary. PreToolUse hooks exit 2 to block a tool call; the stderr message is what Claude sees. See guard/*.sh and docs/DESIGN.md.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/guard/pretooluse-edit.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/guard/pretooluse-bash.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/guard/posttooluse-audit.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "effortLevel": "high"
}
