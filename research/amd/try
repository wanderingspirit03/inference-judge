#!/usr/bin/env python3
"""./try <cmd> [args...]: run the command on the GPU when it is free.

One queue, first come first served, one holder at a time.  Output streams as
the command writes it; the exit code is the command's (124 when it hit the
time limit in config gpu.try_max_s).  When the command ends, every process it
started is stopped."""
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
import common  # noqa: E402
import gpuqueue as Q  # noqa: E402


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    cfg, state = common.setup()
    with common.hold(state, "try", argv) as h:
        t0 = time.monotonic()
        rc = Q.run(h, argv, max_s=cfg["gpu"]["try_max_s"])
        common.log(f"gpu: exit code {rc} after {time.monotonic() - t0:.1f} s on the GPU"
                   f" ({h.waited_s:.1f} s in the queue)")
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
